# Copie para .env e ajuste os valores antes de rodar.

PORT=3000

# Senha única que protege todas as notas (troque por algo forte).
APP_PASSWORD=troque-esta-senha

# String aleatória longa usada para assinar o cookie de sessão.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=troque-por-uma-string-aleatoria-longa

# Onde o arquivo SQLite fica salvo.
DATA_DIR=./data

# Coloque 1 se o app estiver atrás de HTTPS (ex.: nginx/Caddy com TLS),
# para o cookie de sessão só ser enviado por conexão segura.
COOKIE_SECURE=0

# Só usado com docker-compose.prod.yml (deploy público com Caddy):
# o domínio que aponta pro servidor, pro Caddy emitir o certificado
# HTTPS automaticamente. Veja DEPLOYING-PUBLIC.md.
DOMAIN=pad.seudominio.com

# Opcional: por quantos dias manter backups antigos (veja "Backup" no
# README.md). Padrão: 14.
BACKUP_KEEP_DAYS=14
